<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

<!-- ====================================================================== -->
<!-- PARENT                                                                 -->
<!-- ====================================================================== -->
	<parent>
		<groupId>r01.fabric.businessservices.guice</groupId>
		<artifactId>r01fBusinessServicesGuice</artifactId>
		<version>${revision}</version>
	</parent>

<!-- ====================================================================== -->
<!-- ARTIFACT                                                               -->
<!-- ====================================================================== -->
	<name>r01fBusinessServicesGuiceCoreRESTHK2Classes</name>
	<artifactId>r01fBusinessServicesGuiceCoreRESTHK2Classes</artifactId>

<!-- ====================================================================== -->
<!-- DEPENDENCIES                                                           -->
<!-- ====================================================================== -->
	<dependencies>
		<!-- ////////////////////////////////////////////////////////////// -->
		<!-- R01: BusinessServices :                                        -->
		<!-- ////////////////////////////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.businessservices.guice</groupId>
			<artifactId>r01fBusinessServicesGuiceCoreRESTClasses</artifactId>
			<version>${revision}</version>
		</dependency>
		<dependency>
			<groupId>r01.fabric.businessservices.guice</groupId>
			<artifactId>r01fBusinessServicesGuiceCoreWebServicesClasses</artifactId>
			<version>${revision}</version>
		</dependency>
		<!-- ///////////////////////////////////////////////////// -->
		<!-- R01: JERSEY 3                                         -->
		<!-- ///////////////////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.base.remoteservices</groupId>
			<artifactId>r01fRESTServicesJerseyClasses</artifactId>
			<version>${r01f.base.version}</version>
		</dependency>
		
		<!-- ///////////////////////////////////////// -->
		<!-- WEB CONTAINER                             -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
	    	<groupId>org.glassfish.jersey.containers</groupId>
	    	<artifactId>jersey-container-servlet</artifactId>
	    	<version>3.1.8</version>
	    </dependency>
		<!-- ///////////////////////////////////////// -->
		<!-- HK2 GUICE BRIDGE                          -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
		    <groupId>org.glassfish.hk2</groupId>
		    <artifactId>guice-bridge</artifactId>
		    <version>3.1.1</version>
		</dependency>
		  <dependency>
		    <groupId>org.glassfish.jersey.inject</groupId>
		    <artifactId>jersey-hk2</artifactId>
		    <version>3.1.8</version>
		</dependency>
		<!-- ///////////////////////////////////////// -->
		<!-- ServletAPI                                -->
		<!-- ///////////////////////////////////////// -->
		<!-- [r01fWebProfileClasses] has SevletAPI as a dependency,
			 ... BUT it's SCOPE is PROVIDED so it has to be defined
			     here again -->
		<dependency>
		    <groupId>jakarta.servlet</groupId>
		    <artifactId>jakarta.servlet-api</artifactId>
		    <version>6.0.0</version>
		    <scope>provided</scope>		<!-- BEWARE!!! -->
		</dependency>
	</dependencies>
<!-- ====================================================================== -->
<!-- BUILD                                                                  -->
<!-- ====================================================================== -->
	<build>
		<pluginManagement>
			<plugins>
				<!--
				ECLIPSE (see main pom.xml for further info) ===================
				This plugin has NO effects in maven build:
					m2e ONLY runs some 'standard' goals of the maven pom.xml since the aim of m2e is NOT to be a complete CI tool
					... in order to include 'non-standard' goals in m2e execution and avoid [plugin execution not covered by the eclipse m2e plugin project build lifecycle mapping]
						the 'non-standard' plugin MUST be explicitly included in m2e execution
				-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<!-- flatten plugin -->
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.codehaus.mojo</groupId>
										<artifactId>flatten-maven-plugin</artifactId>
										<versionRange>[1.1.0,)</versionRange>
										<goals>
											<goal>flatten</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
