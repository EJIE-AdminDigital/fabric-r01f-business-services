	<modelVersion>4.0.0</modelVersion>

<!-- ====================================================================== -->
<!-- PROPERTIES                                                             -->
<!-- ====================================================================== -->
	<properties>
		<!---
		**********************************************************************
		WARNING!!
		The jakarta.persistence version MUST be aligned with:
			- the spring version
			- the hibernate version

		When using HIBERNATE 6 / Spring 3: 	                  <jakarta.persistence.version>3.1.0</jakarta.persistence.version>
		When using ECLIPSELINK:                              <jakarta.persistence.version>3.2.0</jakarta.persistence.version>

		[ Very Important! ] 		
	      #######################################################################################
		  [1] Hibernate version should align with the [ Spring Boot version] / [Jakarta Pesistence] 
		      (e.g., SB 3.3.5 uses Hibernate 6.5.3).
		  [2] The Jakarta EE version must follow Hibernate's requirements.  
		       SB 3.3.5      >>>  Hibernate 6.5.3                >>>  jakarta.persistence = 3.1.0		  
		       SB 4.1.0-RC1  >>>> Hibernate 7.2.12.Final         >>>  jakarta.persistence = 3.2.0
		  NOTE: the jakarta.persistence version is set at the r01fBusinessServices pom.xml
		  -->	
		  
		   
	     <!--  Cannonical version for SpringBoot SB 4.1.0-RC1 
	           ###############################################
	           [ Includee also Hibernate version at Hibernate Project: Hibernate 7.2.12.Final ]
	           
	           Last Hibernate version for SpringBoot SB 4.1.0-RC1 
	           ###############################################
	           [ Includee also Hibernate version at Hibernate Project: Hibernate 8.0.0.Alpha1]
	    -->
		  
		 <hibernate.version>8.0.0.Alpha1</hibernate.version>
		
		<!-- Previous Version:
			<hibernate.version>6.5.3.Final</hibernate.version>
		    <hikariCP.version>6.2.1</hikariCP.version> -->
	</properties>
